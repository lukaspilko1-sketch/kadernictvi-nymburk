---
import firma from '../data/firma.json';
interface Props { trida?: string; popisek?: string }
const { trida = '', popisek = 'Zavolat' } = Astro.props;
---
<a class={`tlacitko zavolat ${trida}`} href={firma.telefonOdkaz} data-zavolat>
  <svg class="nuzky-cvak" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <g class="cepel cepel-a"><path d="M16 17L27 4" /><ellipse cx="9" cy="25" rx="3.6" ry="4.8" transform="rotate(22 9 25)" /></g>
    <g class="cepel cepel-b"><path d="M16 17L5 4" /><ellipse cx="23" cy="25" rx="3.6" ry="4.8" transform="rotate(-22 23 25)" /></g>
  </svg>
  <span>{popisek}</span>
</a>
