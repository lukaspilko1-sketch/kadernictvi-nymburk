---
// Ručně kreslené čárové ikony (mírně nepravidelný tah). Nejsou z žádné sady.
interface Props { jmeno: 'hreben' | 'nuzky' | 'britva' | 'kartac'; trida?: string }
const { jmeno, trida = '' } = Astro.props;
---
<svg class={`ikona ${trida}`} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {jmeno === 'hreben' && (<>
    <path d="M5 13.5c.2-2 1.6-3 3.4-3.1l31.6.3c2 0 3.2 1.3 3.1 3.2l-.2 4.4c-.1 1.4-1 2.2-2.3 2.2H7.8c-1.6 0-2.7-1-2.7-2.6z" />
    <path d="M9 20.5l-.3 15.6M13.5 20.8l.1 12.2M18 20.7l-.2 17M22.6 20.9l.1 11.7M27 20.8l-.1 16.2M31.4 20.9l.2 12M35.8 20.7l-.1 15M40.2 20.6l.1 10.5" />
  </>)}
  {jmeno === 'nuzky' && (<>
    <ellipse cx="14" cy="36.5" rx="5.6" ry="7.2" transform="rotate(18 14 36.5)" />
    <ellipse cx="33" cy="37" rx="5.6" ry="7.2" transform="rotate(-20 33 37)" />
    <path d="M16 30.2L31.6 4.8M30.6 30.6L16.8 5.2" />
    <circle cx="23.4" cy="19.2" r="1.1" />
  </>)}
  {jmeno === 'britva' && (<>
    <path d="M6.5 30.5c-.6-3.4 1-5.3 4.4-5.6l22.6-2.6c1.6-.2 2.4.6 2.3 2l-.3 3.6c-.1 1.4-.9 2.2-2.5 2.4L11.4 33c-2.6.3-4.4-.5-4.9-2.5z" />
    <path d="M36 24.6l5.6-9.4c.7-1.2 2-1.5 3-.8M10 25.4l1.4-7.6c.3-1.5 1.5-2.3 3-2 l12 2" />
    <circle cx="35.4" cy="26.4" r="1.2" />
    <path d="M9 38.6c10.2 1.4 20.8 1.2 31 0" />
  </>)}
  {jmeno === 'kartac' && (<>
    <path d="M7.6 22.6c-.2-6.2 3.8-10.2 9.6-10.4h6.8c6.2.2 10.2 4.2 10 10.2l-.1 2.2H7.7z" />
    <path d="M12.6 15.6l-.6 6.6M18 13.2l-.2 9M23.6 13l.2 9.2M29.2 13.4l.3 8.8M34.4 15.8l.6 6.4" />
    <path d="M9 26.8c-.5 4 .4 6.4 3.6 6.8l17.6.3c3.4-.2 4.6-2.6 4.2-7M38.6 33.6l5.4 6.8" />
  </>)}
</svg>
