---
import '@fontsource-variable/fraunces/soft.css';
import '@fontsource-variable/fraunces/soft-italic.css';
import '@fontsource-variable/hanken-grotesk/index.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { firma, seo, okoli } from '../lib/data';
import { fotoBudovy } from '../lib/fotky';
import { sestavJsonLd } from '../lib/jsonld';

interface Props { title?: string; description?: string; cesta?: string; jsonLd?: boolean }
const {
  title = seo.title,
  description = seo.description,
  cesta = '/',
  jsonLd = true,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}${p}`;
const kanonicka = new URL(url(cesta), Astro.site).href;
const og = new URL(url('/og.png'), Astro.site).href;
const logo = new URL(url('/logo-zidle.webp'), Astro.site).href;

// V JSON-LD je jako obrázek salonu fotka budovy (když existuje), jinak og.png.
const budova = fotoBudovy();
const obrazek = budova ? new URL((await getImage({ src: budova, width: 1200, format: 'webp' })).src, Astro.site).href : og;

const ld = sestavJsonLd({ firma, seo: { description: seo.description }, obce: okoli.obce, url: kanonicka, obrazek, logo });
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f4f2" />
    <link rel="canonical" href={kanonicka} />
    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={kanonicka} />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script is:inline>document.documentElement.classList.add('js')</script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body>
    <slot />
  </body>
</html>
