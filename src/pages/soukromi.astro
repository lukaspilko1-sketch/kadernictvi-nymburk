---
import Base from '../layouts/Base.astro';
import { firma } from '../lib/data';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const provozovatel = [firma.provozovatel.jmeno.trim(), firma.provozovatel.ic.trim() ? `IČ ${firma.provozovatel.ic.trim()}` : ''].filter(Boolean).join(', ');
---
<Base title="Ochrana soukromí | Kadeřnictví a holičství Nymburk" description="Web nepoužívá cookies ani sledovací nástroje." cesta="/soukromi/" jsonLd={false}>
  <main class="obal obal-uzky text-stranka">
    <p><a href={`${base}/`}>← Zpět na úvod</a></p>
    <h1>Ochrana soukromí</h1>
    <p>Tento web nepoužívá cookies, nesleduje návštěvníky a neobsahuje analytické ani reklamní nástroje. Neukládáme žádné osobní údaje.</p>
    <p>Fonty jsou součástí webu a nenačítají se z cizích serverů.</p>
    <p>Na stránce jsou odkazy na Mapy.cz a Facebook (případně vložená mapa z OpenStreetMap, která se načte, až se k ní dostanete). Po kliknutí na odkaz na cizí web se na něj vztahují jeho vlastní podmínky.</p>
    <p>Do salonu stačí přijít v otevírací době. Kdybyste nás chtěli zastihnout předem, zavolejte na <a href={firma.telefonOdkaz}>{firma.telefon}</a>.</p>
    {provozovatel ? (
      <p>Správce údajů a provozovatel: {provozovatel}. Provozovna: {firma.adresa.ulice}, {firma.adresa.mesto}.</p>
    ) : (
      <p class="mala">Provozovna: {firma.adresa.ulice}, {firma.adresa.mesto}.</p>
    )}
  </main>
</Base>
