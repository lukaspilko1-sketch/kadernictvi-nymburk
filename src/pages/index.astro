---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Ikona from '../components/Ikona.astro';
import Rohy from '../components/Rohy.astro';
import ZavolatTlacitko from '../components/ZavolatTlacitko.astro';
import FbIkona from '../components/FbIkona.astro';
import { firma, cenik, sluzby } from '../lib/data';
import { galerieFotky, fotka, fotoBudovy } from '../lib/fotky';
import { dnyPoradi } from '../lib/otevreno';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (p: string) => `${base}${p}`;

const menu = [
  ['hodiny', 'Hodiny'],
  ['sluzby', 'Služby'],
  ['cenik', 'Ceník'],
  ['o-nas', 'O nás'],
  ['galerie', 'Galerie'],
  ['kontakt', 'Kontakt'],
];

const dnyNazvy: Record<string, string> = { po: 'Pondělí', ut: 'Úterý', st: 'Středa', ct: 'Čtvrtek', pa: 'Pátek', so: 'Sobota', ne: 'Neděle' };
const hodiny = firma.hodiny as Record<string, { od: string; do: string } | null>;
const dnyKratce: Record<string, string> = { po: 'Po', ut: 'Út', st: 'St', ct: 'Čt', pa: 'Pá', so: 'So', ne: 'Ne' };
const cas = (s: string) => s.replace(/^0/, '');
const kc = (n: number) => `${n.toLocaleString('cs-CZ')} Kč`;

const { lat, lon } = firma.souradnice;
// Mapa s iframe jen když jsou souřadnice, jinak karta s adresou a odkazem na Mapy.cz.
const mapaSrc = lat != null && lon != null
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${(lon - 0.004).toFixed(5)}%2C${(lat - 0.0025).toFixed(5)}%2C${(lon + 0.004).toFixed(5)}%2C${(lat + 0.0025).toFixed(5)}&layer=mapnik&marker=${lat}%2C${lon}`
  : null;
const mapyUrl = `https://mapy.cz/zakladni?q=${encodeURIComponent(`${firma.adresa.ulice}, ${firma.adresa.mesto}`)}`;

const heroA = fotka('panske-4.jpg');
const heroB = fotka('detske-1.jpg');
const heroC = fotka('panske-5.jpg');
const budova = fotoBudovy();
const oNasFoto = fotka('panske-1.jpg');

const galerie = galerieFotky();
const velke = await Promise.all(galerie.map((f) => getImage({ src: f.img, width: 1000, format: 'webp' })));

---
<Base>
  <a class="preskocit" href="#obsah">Přeskočit na obsah</a>

  <header class="hlavicka" id="hlavicka">
    <div class="hlavicka-vnitrek">
      <a class="logo" href={href('/')}>
        <img class="logo-zidle" src={href('/logo-zidle.webp')} alt="" width="120" height="120" />
        <span class="logo-text"><span class="logo-radek">Kadeřnictví <span class="amp">&amp;</span> holičství</span> <em>Nymburk</em></span>
      </a>
      <button class="menu-tlacitko" type="button" aria-expanded="false" aria-controls="menu">
        <span class="sr">Menu</span>
        <span class="cary" aria-hidden="true"></span>
      </button>
      <nav class="menu" id="menu" aria-label="Hlavní menu">
        <ul>
          {menu.map(([id, n]) => <li><a href={`#${id}`}>{n}</a></li>)}
          <li class="menu-fb"><a href={firma.facebook} target="_blank" rel="noopener noreferrer">Facebook salonu</a></li>
        </ul>
      </nav>
      <a class="hlavicka-fb" href={firma.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook salonu, otevře se v novém okně"><FbIkona /></a>
      <a class="hlavicka-tel" href={firma.telefonOdkaz}>{firma.telefon}</a>
    </div>
  </header>

  <main id="obsah">
    <section class="uvod" aria-labelledby="hero-nadpis">
      <div class="hero">
        <div class="hero-text">
          <h1 id="hero-nadpis"><span class="h1-r" style="--i:0">Péče o vlasy.</span><span class="h1-r" style="--i:1">Pro každého.</span><span class="h1-r" style="--i:2"><em>Bez objednání.</em></span></h1>
          <p class="podnadpis"><span class="podnadpis-r">Pánové a děti</span><span class="podnadpis-r adresa-radek">{firma.adresa.ulice}, {firma.adresa.mesto}</span></p>
          <div class="hero-akce">
            <ZavolatTlacitko />
          </div>
        </div>
        <div class="hero-foto">
          {heroA && <figure class="hf hf-a"><Picture src={heroA} alt="Mladý muž po střihu s vyholenými boky" formats={['avif', 'webp']} widths={[320, 480, 640]} sizes="(min-width: 900px) 320px, 55vw" loading="eager" fetchpriority="high" /></figure>}
          {heroB && <figure class="hf hf-b"><Picture src={heroB} alt="Usměvavý chlapec po střihu" formats={['avif', 'webp']} widths={[240, 360, 480]} sizes="(min-width: 900px) 220px, 40vw" loading="eager" /></figure>}
          {heroC && <figure class="hf hf-c"><Picture src={heroC} alt="Pohled zezadu na pánský fade s vyholeným vzorem" formats={['avif', 'webp']} widths={[200, 320, 400]} sizes="(min-width: 900px) 190px, 34vw" loading="eager" /></figure>}
        </div>
      </div>

      <div class="pas" id="hodiny" role="region" aria-labelledby="pas-nadpis" data-hodiny={JSON.stringify(firma.hodiny)}>
        <div class="pas-vnitrek">
          <p class="pas-fb">Aktuální otevírací dobu a změny najdete na <a href={firma.facebook} target="_blank" rel="noopener noreferrer">Facebooku<FbIkona trida="fb-mala" /></a>.</p>
          <div class="pas-text">
            <h2 id="pas-nadpis">Stačí přijít. Bez objednání.</h2>
            <p class="pas-stav" data-stav-dnes><span class="tecka" aria-hidden="true"></span><span data-stav-text></span></p>
          </div>
          <div class="pas-prava">
          <ul class="pas-dny">
            {dnyPoradi.map((d) => (
              <li data-den={d} data-reveal class={hodiny[d] ? '' : 'zavreno-den'}>
                <span class="pas-den" aria-hidden="true">{dnyKratce[d]}</span>
                <span class="sr">{dnyNazvy[d]}</span>
                <span class="pas-cas">{hodiny[d] ? <>{cas(hodiny[d]!.od)}–<wbr />{cas(hodiny[d]!.do)}</> : 'zavřeno'}</span>
              </li>
            ))}
          </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="sekce sluzby" id="sluzby" aria-labelledby="sluzby-nadpis">
      <div class="obal">
        <h2 id="sluzby-nadpis" data-reveal>{sluzby.nadpis}</h2>
        <ol class="sluzby-seznam">
          {sluzby.polozky.map((s: any, i: number) => (
            <li class={`sluzba ${i % 2 ? 'obracene' : ''}`} data-reveal>
              <div class="sluzba-foto">
                {<Picture src={fotka(s.foto)} alt={s.alt} formats={['avif', 'webp']} widths={[240, 360, 480]} sizes="(min-width: 700px) 240px, 60vw" loading="lazy" />}
              </div>
              <div class="sluzba-text">
                <Ikona jmeno={s.ikona} trida="ikona-velka" />
                <h3>{s.nazev}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sekce cenik" id="cenik" aria-labelledby="cenik-nadpis">
      <div class="obal obal-uzky">
        <h2 id="cenik-nadpis" data-reveal>Ceník</h2>
        <div class="zalozky" role="tablist" aria-label="Skupina ceníku">
          {cenik.skupiny.map((s, i) => (
            <button class="zalozka" role="tab" type="button" id={`zal-${s.id}`} aria-controls={`panel-${s.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.nazev}</button>
          ))}
        </div>
        {cenik.skupiny.map((s, i) => (
          <div class="cenik-panel" role="tabpanel" id={`panel-${s.id}`} aria-labelledby={`zal-${s.id}`} data-panel-vychozi={i === 0 ? 'ano' : 'ne'}>
            <div class="listek" data-reveal>
              <Rohy />
              <img class="listek-ikona" src={href('/logo-mark.svg')} alt="" width="52" height="54" />
              <h3 class="listek-nadpis">Ceník {s.nazev}</h3>
              {s.sekce.length > 0 ? (
                s.sekce.map((sek) => (
                  <section class="listek-sekce">
                    <h4>{sek.nazev}</h4>
                    <ul>
                      {sek.polozky.map((p) => (
                        <li><span class="nazev">{p.nazev}{p.poznamka && <small class="poznamka"> ({p.poznamka})</small>}</span><span class="vedouci" aria-hidden="true"></span><span class="cena">{kc(p.cena)}</span></li>
                      ))}
                    </ul>
                  </section>
                ))
              ) : (
                <>
                  {s.poznamka ? <p class="listek-poznamka">{s.poznamka}</p> : <p class="listek-prazdny">Ceník doplníme.</p>}
                  <p class="listek-prazdny">Máte dotaz? Zavolejte nám na <a href={firma.telefonOdkaz}>{firma.telefon}</a>.</p>
                </>
              )}
              {s.sekce.length > 0 && <p class="listek-platnost">Ceník platný od {cenik.platnostOd}.</p>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="sekce o-nas" id="o-nas" aria-labelledby="o-nas-nadpis">
      <div class="obal o-nas-mrizka">
        <div class="o-nas-foto" data-reveal>
          {oNasFoto && <Picture src={oNasFoto} alt="Pán s vysoko vyčesaným blond vrškem po střihu" formats={['avif', 'webp']} widths={[320, 480, 640]} sizes="(min-width: 800px) 360px, 80vw" loading="lazy" />}
        </div>
        <div class="o-nas-text" data-reveal>
          <h2 id="o-nas-nadpis">{firma.oNas.nadpis}</h2>
          {firma.oNas.text.map((t) => <p>{t}</p>)}
          {/* TODO: skutečný text o salonu a fotka salonu od majitelky (src/data/firma.json) */}
        </div>
      </div>
    </section>

    <section class="sekce galerie" id="galerie" aria-labelledby="galerie-nadpis">
      <div class="obal">
        <h2 id="galerie-nadpis" data-reveal>Z naší židle</h2>
      </div>
      <ul class="stena">
        {galerie.map((f, i) => (
          <li class={`stena-polozka s${i % 9}`} data-reveal>
            <a href={velke[i].src} data-lightbox data-alt={f.alt} aria-label={`Zvětšit fotku: ${f.alt}`}>
              <Picture src={f.img} alt={f.alt} formats={['avif', 'webp']} widths={[240, 360, 480]} sizes="(min-width: 900px) 280px, 70vw" loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="sekce kontakt" id="kontakt" aria-labelledby="kontakt-nadpis">
      <div class="obal kontakt-mrizka">
        <div class="kontakt-text" data-reveal>
          <h2 id="kontakt-nadpis">Kontakt</h2>
          <address>
            <p class="adresa">{firma.adresa.ulice}<br />{firma.adresa.mesto}</p>
            <p><a class="telefon-velky" href={firma.telefonOdkaz}>{firma.telefon}</a></p>
            <p><a href={firma.facebook} rel="noopener noreferrer" target="_blank">Facebook salonu</a></p>
          </address>
          <p class="kontakt-hodiny">Otevřeno pondělí až pátek, o víkendu zavřeno. <a href="#hodiny">Hodiny nahoře</a>.</p>
          <ZavolatTlacitko />
        </div>
        <div class={`kontakt-media${budova ? ' s-fotkou' : ''}`}>
        <div class="mapa" data-reveal>
          {mapaSrc ? (
            <iframe title="Mapa s polohou salonu (OpenStreetMap)" loading="lazy" referrerpolicy="no-referrer" src={mapaSrc}></iframe>
          ) : (
            <div class="mapa-karta">
              <Ikona jmeno="hreben" trida="ikona-velka" />
              <p class="mapa-adresa">{firma.adresa.ulice}<br />{firma.adresa.mesto}</p>
              <a class="tlacitko tlacitko-svetle" href={mapyUrl} rel="noopener noreferrer" target="_blank"><span>Trasa na Mapy.cz</span></a>
            </div>
          )}
        </div>
        {budova && (
          <figure class="budova" data-reveal>
            <Picture src={budova} alt="Salon Kadeřnictví a holičství Nymburk, vstup z ulice Zbožská" formats={['avif', 'webp']} widths={[320, 480, 640, 800]} sizes="(min-width: 900px) 330px, 100vw" loading="lazy" />
          </figure>
        )}
        </div>
      </div>
    </section>
  </main>

  <footer class="paticka">
    <div class="obal paticka-vnitrek">
      <p><strong>{firma.nazev}</strong><br />{firma.adresa.ulice}, {firma.adresa.mesto}</p>
      <p><a href={firma.telefonOdkaz}>{firma.telefon}</a></p>
      <p><a href={href('/soukromi/')}>Ochrana soukromí</a></p>
    </div>
  </footer>

  <a class="zavolat-lista" href={firma.telefonOdkaz}>Zavolat {firma.telefon}</a>

  <dialog class="lightbox" aria-label="Zvětšená fotka">
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button class="lb-zavrit" type="button" aria-label="Zavřít">×</button>
    <button class="lb-pred" type="button" aria-label="Předchozí fotka">‹</button>
    <button class="lb-dalsi" type="button" aria-label="Další fotka">›</button>
  </dialog>

  <script>
    import { stavDnes } from '../lib/otevreno';
    // hodiny dodává server (data-hodiny na pásu), nic se nenačítá z JSON
    const hodiny = JSON.parse(document.getElementById('hodiny')?.dataset.hodiny ?? '{}');

    // Štítek otevřeno / zavřeno + zvýraznění dnešního dne (čas Europe/Prague)
    const aktualizuj = () => {
      const s = stavDnes(hodiny);
      const stitek = document.querySelector<HTMLElement>('[data-stav-dnes]');
      const text = document.querySelector<HTMLElement>('[data-stav-text]');
      if (stitek && text) {
        text.textContent = s.text;
        stitek.classList.toggle('otevreno', s.otevreno);
        stitek.classList.toggle('zavreno', !s.otevreno);
      }
      document.querySelectorAll('[data-den]').forEach((r) => {
        const dnes = r.getAttribute('data-den') === s.den;
        r.classList.toggle('dnes', dnes);
        if (dnes) r.setAttribute('aria-current', 'date');
        else r.removeAttribute('aria-current');
      });
    };
    try {
      aktualizuj();
      setInterval(aktualizuj, 60_000);
    } catch {
      /* bez štítku, tabulka hodin zůstává */
    }

    // Menu (mobil)
    const tl = document.querySelector<HTMLButtonElement>('.menu-tlacitko');
    const menu = document.getElementById('menu');
    const hlavicka = document.getElementById('hlavicka');
    const zavriMenu = () => {
      tl?.setAttribute('aria-expanded', 'false');
      hlavicka?.classList.remove('menu-otevrene');
    };
    tl?.addEventListener('click', () => {
      const otevrene = tl.getAttribute('aria-expanded') === 'true';
      tl.setAttribute('aria-expanded', String(!otevrene));
      hlavicka?.classList.toggle('menu-otevrene', !otevrene);
    });
    menu?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) zavriMenu();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') zavriMenu();
    });

    // Záložky ceníku (bez JS jsou vidět všechny tři ceníky pod sebou)
    const zalozky = Array.from(document.querySelectorAll<HTMLButtonElement>('.zalozka'));
    const vyber = (z: HTMLButtonElement, fokus = false) => {
      zalozky.forEach((b) => {
        const on = b === z;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        const p = document.getElementById(b.getAttribute('aria-controls')!);
        if (p) p.hidden = !on;
      });
      if (fokus) z.focus();
    };
    zalozky.forEach((z, i) => {
      z.addEventListener('click', () => vyber(z));
      z.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') vyber(zalozky[(i + 1) % zalozky.length], true);
        if (e.key === 'ArrowLeft') vyber(zalozky[(i - 1 + zalozky.length) % zalozky.length], true);
      });
    });
    if (zalozky.length) vyber(zalozky[0]);

    // Scroll-reveal
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const prvky = document.querySelectorAll('[data-reveal]');
    if (reduced || !('IntersectionObserver' in window)) {
      prvky.forEach((p) => p.classList.add('is-in'));
    } else {
      // Prvky ve skupině (stejný rodič) se odhalují postupně, po 150 ms, max. 6 kroků.
      const io = new IntersectionObserver(
        (zaznamy) => {
          let krok = 0;
          zaznamy.forEach((z) => {
            if (z.isIntersecting) {
              (z.target as HTMLElement).style.setProperty('--d', `${Math.min(krok++, 5) * 0.15}s`);
              z.target.classList.add('is-in');
              io.unobserve(z.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      prvky.forEach((p) => io.observe(p));
    }

    // Lightbox
    const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
    const odkazy = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]'));
    if (dlg && odkazy.length) {
      const img = dlg.querySelector('img')!;
      const cap = dlg.querySelector('figcaption')!;
      let idx = 0;
      const ukaz = (i: number) => {
        idx = (i + odkazy.length) % odkazy.length;
        const a = odkazy[idx];
        img.src = a.href;
        img.alt = a.dataset.alt ?? '';
        cap.textContent = a.dataset.alt ?? '';
      };
      odkazy.forEach((a, i) =>
        a.addEventListener('click', (e) => {
          e.preventDefault();
          ukaz(i);
          dlg.showModal();
        }),
      );
      dlg.querySelector('.lb-zavrit')!.addEventListener('click', () => dlg.close());
      dlg.querySelector('.lb-pred')!.addEventListener('click', () => ukaz(idx - 1));
      dlg.querySelector('.lb-dalsi')!.addEventListener('click', () => ukaz(idx + 1));
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') ukaz(idx - 1);
        if (e.key === 'ArrowRight') ukaz(idx + 1);
      });
      dlg.addEventListener('click', (e) => {
        if (e.target === dlg) dlg.close();
      });
    }
  </script>
</Base>
